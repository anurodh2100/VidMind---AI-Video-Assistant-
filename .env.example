# ── Required ──────────────────────────────────────────────
# Used for summarization, extraction (action items/decisions/questions),
# and the RAG chat engine (ChatMistralAI)
MISTRAL_API_KEY=your_mistral_api_key_here

# Whisper model size for English transcription (tiny/base/small/medium/large)
WHISPER_MODEL=small

# Sarvam STT model to use for Hinglish transcription
SARVAM_API_KEY = your_sarvam_api_key
SARVAM_STT_MODEL=saaras:v3
